# Copy to .env — never commit .env
# === Required: YOUR Blofin API (each trader uses their own keys) ===
BLOFIN_API_KEY=
BLOFIN_SECRET=
BLOFIN_PASSPHRASE=
BLOFIN_MODE=demo
DRY_RUN=false
SCALP_3R_MODE=true
SCALP_3R_MIN_RR=3.0
SCALP_3R_HARVEST_MIN_R=2.9
# >=3 closed wins/hour at exchange 3:1 TP/SL (disables LLM scan path, loosens gates when starved)
HOURLY_3R_WINNER_MODE=true
TPSL_ONLY_PACING=true
TPSL_PACE_GAP_AFTER_TP_SECONDS=4
TPSL_PACE_GAP_AFTER_SL_SECONDS=12
SCALP_FAST_3R=true
SCALP_MAX_STOP_PCT=0.010
SCALP_MAX_TAKE_PCT=0.030
SCALP_3R_HARVEST_MIN_R=3.0
OPTIMIZER_TARGET_MIN_WINS_PER_HOUR=3
OPTIMIZER_TARGET_MIN_TPH=8
OPTIMIZER_QUALITY_FIRST=true
# No open-count cap — margin only; quality gates pick winners (never loosen for throughput)
ENTRIES_NEVER_PAUSE=true
UNIVERSE_FILL_MODE=true
MAX_POSITIONS=0
MAX_OPENS_PER_TICK=99
MICRO_EQUITY_MAX_OPEN=99
SMALL_ACCOUNT_MAX_OPEN=99
# Winner-first: never loosen gates when starved; raise bar from live WR; block toxic symbols
QUALITY_PICK_MODE=true
# Qwen vets top finalists after ML/winner/pick (uses ever-learning cortex). On by default with overseer.
LLM_COPILOT_TRADING=true
LLM_COPILOT_STRICT=true
# Qwen reviews open positions (~60s) and recent closes (~10m) for curve protection
LLM_EXIT_ADVISOR=true
LLM_EXIT_ADVISOR_INTERVAL_SEC=60
LLM_AUTOPSY_ENABLED=true
LLM_AUTOPSY_INTERVAL_SEC=600
LLM_TRADING_ENABLED=false
MOMENTUM_WAVE_MODE=false
SCALP_LEVERAGE=50
SCALP_LEVERAGE_MAX=50
THROUGHPUT_BRAIN_ENABLED=true
# Let winners run to exchange TP/SL; no discretionary 50-60% ROE harvest
SCALP_ROE_HARVEST_ENABLED=false
STACK_WINNERS_MODE=true
EARLY_HARVEST_ENABLED=false
LEVERAGE_AUTO_UPGRADE=false
LEVERAGE_ROTATE_WHEN_STARVED=false
OPTIMIZER_ENABLED=true
# Hourly maintainer intelligence (Task Scheduler BlofinHourlyMaintain)
HOURLY_BRAIN_ENABLED=true
HOURLY_AUTOCODE_ENABLED=true
# Per-trade AI lessons (real-time tuning + ML refit from each close)
TRADE_LESSONS_ENABLED=true
TRADE_LESSON_ML_REFIT_EVERY=2
# Optional LLM for hourly_autocode.py (falls back to templates)
# HOURLY_CODEGEN_BASE_URL=http://127.0.0.1:1234/v1
OPTIMIZER_TARGET_MAX_TPH=12

# Micro account safety (~$3 equity): caps opens, pauses after 6% session drawdown
# UNRESTRICTED_TRADING=false keeps mission/fluid/markov entry pauses active
UNRESTRICTED_TRADING=false
# ENTRIES_NEVER_PAUSE=true — always scan/open when margin allows; optimizers still tune gates
ENTRIES_NEVER_PAUSE=true
# Steepen the dashboard account curve (default on; legacy alias CURVE_MAXIMIZER)
ACCOUNT_CURVE_MAXIMIZE=true
# Confluence-core logic + backtest tuning + learning brain in one bot.py (stop growth_agent.py)
GROWTH_SUPERCHARGE_ENABLED=true
# Steady directional runners vs choppy up/down (helps vertical account curve)
RUNNER_FILTER_ENABLED=true
RUNNER_MIN_SCORE=0.48
RUNNER_MAX_CHOP=0.56
RUNNER_MIN_PATH_EFF=0.26
# Auto ML refit + cortex rebuild (no manual train_model / train_local_cortex)
ML_AUTO_REFIT_ON_STARTUP=true
CORTEX_AUTO_TRAIN=true
CORTEX_TRAIN_ON_STARTUP=true
CORTEX_TRAIN_INTERVAL_MINUTES=15
CORTEX_TRAIN_MIN_NEW_CLOSES=1
MICRO_EQUITY_THRESHOLD=10
MICRO_EQUITY_MAX_OPEN=3
MICRO_DRAWDOWN_PAUSE_PCT=6
MICRO_MAX_MARGIN_FRAC=0.12
SMALL_ACCOUNT_MAX_OPEN=3

# Margin mode: cross (shared wallet) or isolated (per-position collateral)
MARGIN_MODE=cross
# Steward auto-migrates isolated positions back to cross (close + reopen + TPSL)
AUTO_CROSS_MARGIN_MIGRATE=true
AUTO_CROSS_MARGIN_INTERVAL_SEC=90
AUTO_CROSS_MARGIN_SYMBOL_COOLDOWN_SEC=300
# Fast 3R lethal TPSL (cross): fixed ~1%% stop / ~3%% take — no liq-gap brackets.
# SCALP_SKIP_LIQ_TPSL also disables liquidation-guard sizing, liq-room entry skips, and pre-liq steward exits.
SCALP_FAST_3R=true
SCALP_SKIP_LIQ_TPSL=true
SCALP_FAST_MAX_STOP_PCT=0.010
SCALP_FAST_MAX_TAKE_PCT=0.030
SCALP_MOMENTUM_MAX_STOP_PCT=0.014
SCALP_3R_HARVEST_MIN_R=1.0
SCALP_MIN_HOLD_SECONDS=18
# Anti-liquidation: margin_rate floor for sizing/TPSL (cross: 100% min lot is normal)
MIN_MARGIN_RATE=1.00
TARGET_MARGIN_RATE=1.08
# Isolated only — Blofin 152404 on cross; keep false for cross margin
MARGIN_TOP_UP_ENABLED=false
MAX_EFFECTIVE_LEVERAGE=32
MAX_STOP_LIQ_FRACTION=0.26
SL_LIQ_BUFFER=0.44
PRE_LIQUIDATION_EXIT_FACTOR=0.40
MARGIN_USE_FRACTION=0.97

# WhatsApp (Twilio + Option A local GGUF)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_ALLOWED_NUMBERS=15551234567

# Local LLM: auto prefers LM Studio (smart+fast) → GGUF → HF 1.5B
# auto | llama_cpp | hf_local | openai_compat
WHATSAPP_LLM_PROVIDER=auto
# WHATSAPP_LLM_BASE_URL=http://127.0.0.1:1234/v1
# WHATSAPP_LLM_HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# WHATSAPP_LLM_HF_MODE=auto

# Fast+smart GGUF (run: scripts\setup_local_llm.ps1 -DownloadModel 3b)
# WHATSAPP_LLM_GGUF_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf
WHATSAPP_LLM_N_CTX=8192
WHATSAPP_LLM_N_GPU_LAYERS=-1
WHATSAPP_LLM_N_BATCH=512
WHATSAPP_LLM_TOP_P=0.9
WHATSAPP_LLM_REPEAT_PENALTY=1.12
LOCAL_CORTEX_ENABLED=true
LOCAL_CORTEX_MAX_EXAMPLES=4
LOCAL_CORTEX_MAX_KNOWLEDGE_CHARS=5500
LOCAL_CORTEX_CHAT_MAX_KNOWLEDGE_CHARS=2200
LOCAL_CORTEX_CHAT_MAX_EXAMPLES=2

# Speed stack (lightning path)
WHATSAPP_LLM_FAST=true
WHATSAPP_LLM_POLICY_TIMEOUT_SEC=12
WHATSAPP_LLM_POLICY_MAX_TOKENS=128
WHATSAPP_LLM_POLICY_CONTEXT_CHARS=3200
LOCAL_CORTEX_POLICY_MAX_KNOWLEDGE_CHARS=1400

# Live LLM trading brain
LLM_TRADING_ENABLED=true
LLM_TRADING_USE_CORTEX=true
LLM_TRADING_MAX_TOKENS=128
LLM_POLICY_CACHE_SEC=45

# LLM-only mode: 7B GGUF is the SOLE entry brain (no winner/ML/pick after policy)
# Setup: powershell -File scripts\enable_llm_only_7b.ps1
# LLM_ONLY_TRADING=true
# LLM_TRADING_FAIL_OPEN=false
# LLM_TRADING_STRICT=true
# WHATSAPP_LLM_PROVIDER=llama_cpp
# WHATSAPP_LLM_GGUF_PATH=models/qwen2.5-7b-instruct-q3_k_m.gguf
# HOURLY_3R_WINNER_MODE=false
# SYMBOLS_PER_TICK=32

# Bob's Bots storefront (public shop — port 5070)
# STOREFRONT_PORT=5070
# STOREFRONT_SITE_URL=http://127.0.0.1:5070
# STOREFRONT_STRIPE_SECRET_KEY=
# STOREFRONT_STRIPE_WEBHOOK_SECRET=
# STOREFRONT_CRYPTO_BTC_ADDRESS=
# STOREFRONT_CRYPTO_ETH_ADDRESS=
# STOREFRONT_CRYPTO_USDT_TRC20=
# STOREFRONT_LLM_MAX_TOKENS=600
# BOBS_BOTS_LICENSE=   # customer license key after purchase

# Dashboard Copilot — lean prompts = faster replies
# DASHBOARD_COPILOT_MAX_TOKENS=720
# DASHBOARD_COPILOT_CODE_MAX_TOKENS=2400
# DASHBOARD_LLM_TIMEOUT_SEC=180
# DASHBOARD_LLM_WARMUP_WAIT_SEC=300
# DASHBOARD_LLM_KEEPALIVE_SEC=600
